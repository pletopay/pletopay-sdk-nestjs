{
  "name": "@pletopay/nestjs",
  "version": "1.0.0",
  "description": "Official NestJS module for the Pletopay API: an injectable client, a webhook guard that verifies X-PletoPay-Signature, and @OnPletopayEvent handlers.",
  "license": "MIT",
  "author": "Pletopay",
  "homepage": "https://docs.pletopay.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evidenze/pletopay-sdk-nestjs.git"
  },
  "bugs": {
    "url": "https://github.com/evidenze/pletopay-sdk-nestjs/issues"
  },
  "keywords": [
    "pletopay",
    "nestjs",
    "nest",
    "payments",
    "nigeria",
    "bank transfer",
    "webhooks",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{src,test,scripts,examples}/**/*.{ts,mjs,js}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,test,scripts,examples}/**/*.{ts,mjs,js}\" \"*.{json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "check:brand": "node scripts/check-brand.mjs",
    "check:package": "pnpm build && publint && attw --pack . --profile node16",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:brand && pnpm test && pnpm check:package",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "@pletopay/node": "^1.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-fastify": "^11.2.6",
    "@nestjs/testing": "^11.2.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "overrides": {
      "@pletopay/node": "link:../pletopay-sdk-node"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
